#!/bin/sh
# test/run - run every bootique in-repo test (*.t), then lint every shell file.
# Non-zero if anything fails. No root, nothing on the box is touched.
set -eu
# shellcheck disable=SC1007  # `CDPATH= cd` neutralises a set CDPATH for ONE
# command; it is not a botched assignment.
HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# shellcheck disable=SC1007  # same `CDPATH= cd` idiom as above.
REPO=$(CDPATH= cd -- "$HERE/.." && pwd)
_fail=0
for _t in "$HERE"/*.t; do
  [ -e "$_t" ] || continue
  sh "$_t" || _fail=1
done

# --- lint ---------------------------------------------------------------
# Gated HERE rather than left to whoever remembers to run it. The file was
# carrying 19 warnings, all benign, which is precisely how a real one goes
# unread: nobody scans a list that is always noise. It is clean now, so any
# new warning is signal. Every deliberate exception carries an inline
# `# shellcheck disable=` with its reason.
#
# SKIPPED, loudly, when shellcheck is absent: a linter that silently does not
# run is worse than no linter, because the suite still prints success.
if command -v shellcheck >/dev/null 2>&1; then
  # Run from the REPO ROOT. `# shellcheck source=` is resolved relative to the
  # working directory, so linting from anywhere else made shellcheck unable to
  # follow test/harness_lib and fail the gate -- and `setup.sh test` runs
  # this from WHEREVER the caller stood, so the suite passed from the repo
  # and failed from anywhere else. Caught by running it over ssh from $HOME.
  cd "$REPO" || exit 1
  # WHAT gets linted is DERIVED, not listed: every tracked file whose shebang
  # says sh. A hand-kept list is how test/vm's four shell files went unlinted
  # for months while the gate reported clean, and how a list built in a
  # VARIABLE once left `*.t` literal, unlinted and green. `set --` puts the
  # derived list in command position instead.
  #
  # test/harness_lib is NOT in the list, deliberately: it has no shebang, so
  # linting it alone only draws SC2148 (unknown shell). `-x` below reaches it
  # in the context that actually loads it, which is the honest way to lint a
  # sourced file.
  set --
  for _f in $(git ls-files); do
    [ "$(head -c 2 "$_f")" = '#!' ] || continue
    case "$(head -1 "$_f")" in *python*) continue ;; esac
    set -- "$@" "$_f"
  done
  # A derivation that finds nothing must FAIL, not lint an empty set green.
  if [ "$#" -lt 8 ]; then
    echo "  FAIL lint: only $# shell file(s) found (expected 8+)" >&2
    _fail=1
  # -x so a sourced helper (test/harness_lib) is followed rather than
  # warned about.
  elif shellcheck -x "$@"; then
    echo "  ok   shellcheck clean"
  else
    echo "  FAIL shellcheck" >&2; _fail=1
  fi
else
  echo "  SKIP shellcheck not installed (lint NOT run)" >&2
fi

if [ "$_fail" = 0 ]; then
  echo "all bootique tests passed"
else
  echo "bootique: TESTS FAILED" >&2; exit 1
fi
