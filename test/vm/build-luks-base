#!/bin/sh
# build-luks-base -- build a clean LUKS+btrfs base image for plymouth-vmcheck to
# render the splash against. Boots a noble cloud image as a headless installer,
# runs `tackdisk install` onto a blank target disk, and powers off. The result
# ($SCRATCH/base-target.qcow2) is a plain bootable target: a LUKS prompt at boot
# and a tester/testerpass login over ttyS0, with the serial getty intact so the
# render harness can drive it. NO firstboot fixture (that is the grub-btrfs
# rollback test's concern, a separate harness).
#
#   build-luks-base [scratch-dir]             (default /var/tmp/plyvm)
#
# EXTERNAL DEPENDENCY: the base is installed by `tackdisk`, the day-zero disk
# installer, which lives in a separate checkout. Point TACKDISK_REPO at it
# (default $HOME/src/tackup). This is the one piece of the render harness that
# reaches outside bootique -- building a bootable LUKS OS is the installer's
# job, not the theme's. Override PLYVM_BASE to write the image elsewhere.
#
# Prereqs in scratch-dir: noble-server-cloudimg-amd64.img (a stable Ubuntu cloud
# image -- noble's debootstrap knows its suite; testing with it validates the
# MECHANISM even though a box may run a later release). Needs qemu + xorriso +
# kvm. Host-side, NO sudo (qemu+kvm only; the guest is root, which sidesteps a
# no-TTY sudo shell).
set -eu
HERE=$(cd "$(dirname "$0")" && pwd)
D=${1:-/var/tmp/plyvm}
IMG=$D/noble-server-cloudimg-amd64.img
TACKDISK_REPO=${TACKDISK_REPO:-$HOME/src/tackup}
TARGET=${PLYVM_BASE:-$D/base-target.qcow2}
[ -r "$IMG" ] || { echo "build-luks-base: need $IMG (download a noble cloud" \
  "image)" >&2; exit 2; }
[ -x "$TACKDISK_REPO/tackdisk" ] || { echo "build-luks-base: no tackdisk at" \
  "$TACKDISK_REPO (set TACKDISK_REPO to the installer checkout)" >&2; exit 2; }
mkdir -p "$D"
cd "$D"

echo "== building repo.iso from $TACKDISK_REPO =="
rm -f "$D/base-repo.iso"
xorriso -as mkisofs -R -J -V INSTALLER -o "$D/base-repo.iso" \
  "$TACKDISK_REPO" >/dev/null 2>&1

# The in-guest installer script (runs as root under cloud-init). Its output is
# buffered to a file and dumped to ttyS0 at the very end -- writing to serial
# live interleaves with boot spam and gets lost.
cat > "$D/base-run.sh" <<'GUEST'
#!/bin/sh
{
set -x
echo "##### install a clean LUKS+btrfs base #####"
mkdir -p /mnt/repo && mount -o ro /dev/vdd /mnt/repo
env TACKDISK_YES=1 TACKDISK_LUKS_PASS=testpass123 TACKDISK_USER=tester \
    TACKDISK_PASS=testerpass TACKDISK_HOST=plyvm TACKDISK_SUITE=noble \
    TACKDISK_CONSOLE=console=ttyS0 \
    sh /mnt/repo/tackdisk install /dev/vdb
echo "##### TACKDISK_INSTALL_EXIT=$? #####"
sync
echo "##### BASE DONE #####"
} > /root/base.log 2>&1
cat /root/base.log > /dev/ttyS0
sync; poweroff -f
GUEST

echo "== cloud-init seed (user-data/meta-data MUST be at the iso root) =="
B64=$(base64 -w0 "$D/base-run.sh")
rm -rf "$D/base-seed"; mkdir -p "$D/base-seed"
cat > "$D/base-seed/user-data" <<EOF
#cloud-config
package_update: true
packages: [debootstrap, cryptsetup-bin, gdisk, btrfs-progs]
write_files:
  - path: /root/base-run.sh
    permissions: '0755'
    encoding: b64
    content: $B64
runcmd: [[ sh, /root/base-run.sh ]]
EOF
printf 'instance-id: base-1\nlocal-hostname: baseinst\n' \
  > "$D/base-seed/meta-data"
rm -f "$D/base-seed.iso"
xorriso -as mkisofs -R -J -V CIDATA -o "$D/base-seed.iso" \
  "$D/base-seed/user-data" "$D/base-seed/meta-data" >/dev/null 2>&1

echo "== fresh disks (installer COW over the image; blank 16G target) =="
rm -f "$D/base-installer.qcow2" "$TARGET"
qemu-img create -f qcow2 -F qcow2 -b "$IMG" \
  "$D/base-installer.qcow2" 20G >/dev/null
qemu-img create -f qcow2 "$TARGET" 16G >/dev/null

echo "== launch installer VM (headless; ~5-8 min: debootstrap + install) =="
qemu-system-x86_64 -enable-kvm -m 4096 -smp 2 \
  -drive file="$D/base-installer.qcow2",if=virtio \
  -drive file="$TARGET",if=virtio \
  -drive file="$D/base-seed.iso",if=virtio \
  -drive file="$D/base-repo.iso",if=virtio \
  -netdev user,id=n0 -device virtio-net-pci,netdev=n0 \
  -display none -serial file:"$D/base-console.log" -monitor none -no-reboot
if grep -q "BASE DONE" "$D/base-console.log" 2>/dev/null; then
  echo "== BASE DONE -> $TARGET"
  echo "   next: plymouth-vmcheck $TARGET testpass123"
else
  echo "== base install did NOT finish; tail console:" >&2
  tail -20 "$D/base-console.log" >&2; exit 1
fi
