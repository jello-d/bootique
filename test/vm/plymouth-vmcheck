#!/bin/sh
# test/vm/plymouth-vmcheck - render the bootique plymouth splash headlessly in a
# VM and screendump it, so the theme's real DRM look (the LUKS prompt with
# bullets, the dense boot scroll) is verified WITHOUT rebooting the box. Injects
# the repo theme (plymouth/ + background.png) into an OVERLAY on a clean
# LUKS+btrfs target, so the base image is never mutated.
#
#   plymouth-vmcheck <base-luks.qcow2> <luks-passphrase> [outdir]
#
# Produces PNGs in outdir (default $SCRATCH/shots). Needs kvm +
# qemu-system-x86_64 + OVMF + python3 + imagemagick + socat. Host-side, NO sudo
# (the guest is root). The base is a LUKS+btrfs target built by build-luks-base
# (a tackdisk install); its login user defaults to tester/testerpass (override
# PLYVM_USER/PLYVM_UPASS). See plymouth-prep.sh and plymouth-capture.py for the
# hard-won qemu-display/plymouth details (virtio-gpu-pci, ignore-serial-
# consoles, MODULES=most, the splash hold, sendkey unlock).
set -eu
HERE=$(cd "$(dirname "$0")" && pwd)
REPO=$(cd "$HERE/../.." && pwd)
# The theme is this repo (the harness lives beside it); override with
# PLYVM_BOOTIQUE to render a theme from a different checkout.
BQ=${PLYVM_BOOTIQUE:-$REPO}
[ -d "$BQ/plymouth" ] || { echo "vmcheck: no theme at $BQ/plymouth (set" \
  "PLYVM_BOOTIQUE to a bootique checkout)" >&2; exit 2; }
BASE=${1:?usage: plymouth-vmcheck <base.qcow2> <passphrase> [outdir]}
PASS=${2:?usage: plymouth-vmcheck <base.qcow2> <passphrase> [outdir]}
SCRATCH=${PLYVM_SCRATCH:-/var/tmp/plyvm}
OUT=${3:-$SCRATCH/shots}
GUEST_USER=${PLYVM_USER:-tester}
GUEST_PASS=${PLYVM_UPASS:-testerpass}
# Capture resolution. The theme is fraction-based, so re-running at a second
# resolution (e.g. PLYVM_XRES=1920 PLYVM_YRES=1200) exercises the layout scaling
# and the verify's fraction-resolved crop regions at a different size.
CAP_XRES=${PLYVM_XRES:-1440}
CAP_YRES=${PLYVM_YRES:-900}
OVMF_CODE=${OVMF_CODE:-/usr/share/OVMF/OVMF_CODE_4M.fd}
OVMF_VARS=${OVMF_VARS:-/usr/share/OVMF/OVMF_VARS_4M.fd}
[ -r "$BASE" ] || { echo "vmcheck: no base image $BASE" >&2; exit 2; }
[ -r "$OVMF_CODE" ] || { echo "vmcheck: no OVMF at $OVMF_CODE" >&2; exit 2; }

mkdir -p "$SCRATCH" "$OUT" "$SCRATCH/share/theme"
cp "$HERE/plymouth-prep.sh" "$SCRATCH/share/"
# Which initramfs generator the guest should use (see plymouth-prep.sh). dracut
# is what the real boxes run, and it changes WHO asks for the passphrase
# (systemd-cryptsetup, not initramfs-tools), so both are worth a pass.
PLYVM_INITRD=${PLYVM_INITRD:-initramfs-tools}
case "$PLYVM_INITRD" in
  initramfs-tools|dracut) printf '%s\n' "$PLYVM_INITRD" \
    > "$SCRATCH/share/initrd-mode"
    echo "vmcheck: guest initramfs generator: $PLYVM_INITRD" ;;
  *) echo "vmcheck: PLYVM_INITRD must be initramfs-tools or dracut" >&2
     exit 2 ;;
esac
_tf="bootique.plymouth bootique.script pill.png dot.png shutdown-bg.png"
_tf="$_tf scrim.png"
for f in $_tf; do
  cp "$BQ/plymouth/$f" "$SCRATCH/share/theme/$f"
done
cp "$BQ/background.png" "$SCRATCH/share/theme/background.png"

# Which unlock-prompt behaviour to assert. DERIVED from the theme just copied,
# never assumed: bootique bakes local vs remote into the script at install time,
# and the two modes have opposite correct answers (remote must escalate its
# hint, local must never). Reading it here means the check cannot drift from the
# theme under test.
UNLOCK_MODE=$(sed -n 's/^unlock_mode = "\(.*\)";$/\1/p' \
  "$SCRATCH/share/theme/bootique.script")
case "$UNLOCK_MODE" in
  local|remote) echo "vmcheck: theme unlock mode: $UNLOCK_MODE" ;;
  *) echo "vmcheck: cannot read unlock_mode from the theme (got" \
       "'$UNLOCK_MODE')" >&2; exit 2 ;;
esac

# --- phase 1: prep (install plymouth + inject theme + rebuild initramfs) ------
PREP=$SCRATCH/prep.qcow2
rm -f "$PREP"; qemu-img create -f qcow2 -b "$BASE" -F qcow2 "$PREP" >/dev/null
cp "$OVMF_VARS" "$SCRATCH/prep-vars.fd"
SOCK=$SCRATCH/prep.sock; rm -f "$SOCK"

_mnt='mount -t 9p -o trans=virtio,version=9p2000.L hostshare /mnt/h'
_run="mkdir -p /mnt/h && $_mnt && sh /mnt/h/plymouth-prep.sh"
RUNCMD="echo $GUEST_PASS | sudo -S sh -c '$_run'"
cat > "$SCRATCH/prep.expect" <<EOF
timeout 220
expect (?i)(please unlock|passphrase|unlock disk)
send $PASS
timeout 280
expect login:
send $GUEST_USER
timeout 40
expect (?i)password:
send $GUEST_PASS
timeout 40
expect $GUEST_USER@
send $RUNCMD
timeout 600
expect PLYPREP_DONE
timeout 90
expect (?i)(reboot: Power down|Powering off)
EOF

echo "vmcheck: prep boot (install plymouth + inject theme) ..."
qemu-system-x86_64 -enable-kvm -m 2048 -smp 2 \
  -drive if=pflash,format=raw,readonly=on,file="$OVMF_CODE" \
  -drive if=pflash,format=raw,file="$SCRATCH/prep-vars.fd" \
  -drive file="$PREP",if=virtio,format=qcow2 \
  -netdev user,id=n0 -device virtio-net-pci,netdev=n0 \
  -fsdev local,id=fs0,path="$SCRATCH/share",security_model=none \
  -device virtio-9p-pci,fsdev=fs0,mount_tag=hostshare \
  -display none \
  -chardev socket,id=s0,path="$SOCK",server=on,wait=off -serial chardev:s0 \
  >"$SCRATCH/prep-qemu.log" 2>&1 &
QP=$!
python3 "$HERE/vmexpect" --socket "$SOCK" --script "$SCRATCH/prep.expect" \
  --log "$SCRATCH/prep-serial.log" --timeout 600 \
  || { kill "$QP" 2>/dev/null || true; echo "vmcheck: prep FAILED" >&2
       exit 1; }
kill "$QP" 2>/dev/null || true; wait "$QP" 2>/dev/null || true

# --- phase 2: capture (boot the prepped image, screendump the splash) ---------
CAP=$SCRATCH/cap.qcow2
rm -f "$CAP"; qemu-img create -f qcow2 -b "$PREP" -F qcow2 "$CAP" >/dev/null
cp "$OVMF_VARS" "$SCRATCH/cap-vars.fd"
CSOCK=$SCRATCH/cap.sock; CMON=$SCRATCH/cap-mon.sock
rm -f "$CSOCK" "$CMON" "$OUT"/*.ppm

echo "vmcheck: capture boot (screendump the splash) ..."
qemu-system-x86_64 -enable-kvm -m 2048 -smp 2 \
  -drive if=pflash,format=raw,readonly=on,file="$OVMF_CODE" \
  -drive if=pflash,format=raw,file="$SCRATCH/cap-vars.fd" \
  -drive file="$CAP",if=virtio,format=qcow2 \
  -netdev user,id=n0 -device virtio-net-pci,netdev=n0 \
  -vga none \
  -device virtio-gpu-pci,id=gpu0,edid=on,xres="$CAP_XRES",yres="$CAP_YRES" \
  -device bochs-display,id=gpu1 \
  -display none \
  -chardev socket,id=s0,path="$CSOCK",server=on,wait=off -serial chardev:s0 \
  -monitor unix:"$CMON",server,nowait \
  >"$SCRATCH/cap-qemu.log" 2>&1 &
QC=$!
_caprc=0
python3 "$HERE/plymouth-capture.py" "$CSOCK" "$CMON" "$OUT" "$PASS" \
  >"$SCRATCH/cap-driver.log" 2>&1 || _caprc=$?
kill "$QC" 2>/dev/null || true; wait "$QC" 2>/dev/null || true

# --- convert frames to PNG ----------------------------------------------------
_n=0
for f in "$OUT"/*.ppm; do
  [ -f "$f" ] || continue
  convert "$f" "${f%.ppm}.png" 2>/dev/null && _n=$((_n + 1))
done
echo "vmcheck: wrote $_n PNG frame(s) to $OUT"
echo "vmcheck: key shots -> 01-luks-empty.png 02-luks-bullets.png boot-10.png"

# --- gate: capture must have reached its states, frames must verify -----------
# A capture that never saw the LUKS prompt (rc!=0), or frames that did not
# render the prompt/bg, is a FAILURE -- not a silently-green run. This is what
# turns the harness from a screenshot tool into a repeatable test.
if [ "$_caprc" -ne 0 ]; then
  echo "vmcheck: FAIL -- capture did not reach its states (rc=$_caprc);" \
       "see $SCRATCH/cap-driver.log" >&2
  exit 1
fi
echo "vmcheck: verifying the frames rendered the expected elements ..."
if PLYVM_UNLOCK_MODE=$UNLOCK_MODE python3 "$HERE/plymouth-verify.py" "$OUT"
then
  echo "vmcheck: PASS"
else
  echo "vmcheck: FAIL -- frame verification failed (see the FAIL lines above)" \
       >&2
  exit 1
fi
